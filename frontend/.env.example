# Copy to .env (gitignored) for `npm run dev`. Vite reads VITE_* variables
# at build time, so the built image bakes them in (see Dockerfile args).

# Where the API is, as reachable from the browser.
# VITE_API_BASE_URL=http://localhost:8000

# "dev" (default): sign in by typing an identity subject, sent to the API
# as X-Dev-Subject; the API must run with GREENHOUSE_AUTH_MODE=dev.
# "oidc": sign in through the identity provider (Auth0) and send its
# access token; the API must run with GREENHOUSE_AUTH_MODE=oidc and the
# same audience.
# VITE_AUTH_MODE=dev

# Required for VITE_AUTH_MODE=oidc: the Auth0 tenant domain, the SPA
# application's client id, and the API identifier (audience).
# VITE_OIDC_DOMAIN=your-tenant.eu.auth0.com
# VITE_OIDC_CLIENT_ID=...
# VITE_OIDC_AUDIENCE=https://api.serrapulse.example
