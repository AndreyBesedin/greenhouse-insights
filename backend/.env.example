# Copy this file to .env and fill in real values. .env is gitignored -
# never commit it. The running app (application/api/main.py) loads it
# automatically on startup; a bare `alembic` CLI command does not.

# --- Database ---
# GREENHOUSE_DATABASE_URL=sqlite:///./data/greenhouse.db

# --- Simulation pacing ---
# GREENHOUSE_STEP_DELAY_SECONDS=1.0

# --- CORS: comma-separated list of allowed frontend origins ---
# GREENHOUSE_ALLOWED_ORIGINS=http://localhost:5173

# --- Agentic management provider ---
# "fake" (default, scripted, no API calls) or "anthropic" (real Claude calls,
# billed - see docs/design/greenhouse_agentic_management_design.md and the
# AGENTIC creation caps in application/greenhouse_service.py).
# GREENHOUSE_AGENT_PROVIDER=anthropic

# Required when GREENHOUSE_AGENT_PROVIDER=anthropic. Get one at
# console.anthropic.com (API Keys). Never commit this value.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides for the Anthropic provider (defaults shown):
# GREENHOUSE_AGENT_MODEL=claude-sonnet-5
# GREENHOUSE_AGENT_MAX_TOKENS=1536
# GREENHOUSE_AGENT_REQUEST_TIMEOUT_SECONDS=30
# GREENHOUSE_AGENT_MAX_RETRIES=2
