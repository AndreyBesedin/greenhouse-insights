# Copy this file to .env and fill in real values. .env is gitignored -
# never commit it. The running app (application/api/main.py) loads it
# automatically on startup; a bare `alembic` CLI command does not.

# --- Database ---
# Native development defaults to a local SQLite file; docker compose and the
# deployment run PostgreSQL (docker-compose.yml sets this itself). Either URL
# works - the persistence layer supports both.
# GREENHOUSE_DATABASE_URL=sqlite:///./data/greenhouse.db
# GREENHOUSE_DATABASE_URL=postgresql+psycopg://greenhouse:greenhouse@localhost:5432/greenhouse

# --- Authentication (required; the API refuses to start without it) ---
# "dev": trust an X-Dev-Subject request header naming the caller. Local
# development and tests only - never expose a dev-mode API to the internet.
# "oidc": validate bearer access tokens from an OpenID Connect provider
# (Auth0) against its published signing keys; needs the two OIDC settings
# below and a frontend built with VITE_AUTH_MODE=oidc.
GREENHOUSE_AUTH_MODE=dev

# Required for GREENHOUSE_AUTH_MODE=oidc. The issuer is the tenant URL
# exactly as it appears in the token's iss claim (trailing slash included);
# the audience is the API identifier registered with the provider.
# GREENHOUSE_OIDC_ISSUER=https://your-tenant.eu.auth0.com/
# GREENHOUSE_OIDC_AUDIENCE=https://api.serrapulse.example
# Access tokens for an API carry only the subject unless the provider adds
# claims; name the claims that hold the email and display name (an Auth0
# Action can add namespaced ones). When the email claim is absent the API
# asks the provider's userinfo endpoint once per user and caches it.
# GREENHOUSE_OIDC_EMAIL_CLAIM=https://serrapulse/email
# GREENHOUSE_OIDC_NAME_CLAIM=https://serrapulse/name
# Comma-separated identity subjects granted platform admin when they log
# in (the bootstrap for the first administrator). In dev mode the subject
# is whatever X-Dev-Subject the frontend sends.
# GREENHOUSE_PLATFORM_ADMIN_SUBJECTS=dev-admin

# --- Dataset storage (raw / canonical / features tiers) ---
# GREENHOUSE_DATA_DIR=~/.greenhouse-insights/data

# --- Simulation pacing ---
# GREENHOUSE_STEP_DELAY_SECONDS=1.0

# --- CORS: comma-separated list of allowed frontend origins ---
# GREENHOUSE_ALLOWED_ORIGINS=http://localhost:5173

# --- Agentic management provider ---
# "fake" (default, scripted, no API calls) or "anthropic" (real Claude calls,
# billed - see docs/design/greenhouse_agentic_management_design.md and the
# AGENTIC creation caps in application/greenhouse_service.py).
# GREENHOUSE_AGENT_PROVIDER=anthropic

# Required when GREENHOUSE_AGENT_PROVIDER=anthropic. Get one at
# console.anthropic.com (API Keys). Never commit this value.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides for the Anthropic provider (defaults shown):
# GREENHOUSE_AGENT_MODEL=claude-sonnet-5
# GREENHOUSE_AGENT_MAX_TOKENS=1536
# GREENHOUSE_AGENT_REQUEST_TIMEOUT_SECONDS=30
# GREENHOUSE_AGENT_MAX_RETRIES=2
